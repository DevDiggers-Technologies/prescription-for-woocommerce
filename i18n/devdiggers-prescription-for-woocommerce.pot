#: includes/file-handler.php:42
msgid "[{site_title}] Prescription approved for order #{order_number}"
msgstr ""

#: includes/file-handler.php:43
msgid "Your prescription has been approved"
msgstr ""

#: includes/file-handler.php:45
msgid ""
"<p>Hi {customer_name},</p>\n"
"\t\t\t\t\t\t\t<p>Great news. A pharmacist at {site_title} has reviewed the "
"prescription you uploaded for order #{order_number} and approved it.</p>\n"
"\t\t\t\t\t\t\t<p>Your order is now being prepared for dispatch, so there is "
"nothing further you need to do.</p>\n"
"\t\t\t\t\t\t\t<p>Thank you for trusting us with your prescription.</p>\n"
"\t\t\t\t\t\t\t<p>Best regards</p>"
msgstr ""

#: includes/file-handler.php:56
msgid "[{site_title}] Prescription rejected for order #{order_number}"
msgstr ""

#: includes/file-handler.php:57
msgid "We could not accept your prescription"
msgstr ""

#: includes/file-handler.php:59
msgid ""
"<p>Hi {customer_name},</p>\n"
"\t\t\t\t\t\t\t<p>Thank you for sending your prescription for order "
"#{order_number}. A pharmacist at {site_title} was not able to accept it "
"this time.</p>\n"
"\t\t\t\t\t\t\t<p>{reason}</p>\n"
"\t\t\t\t\t\t\t<p>You are very welcome to send us a replacement whenever you "
"are ready and we will review it as soon as it arrives. {reupload_note}</p>\n"
"\t\t\t\t\t\t\t<p>Thank you for your patience.</p>\n"
"\t\t\t\t\t\t\t<p>Best regards</p>"
msgstr ""

#: includes/file-handler.php:71
msgid "[{site_title}] More information needed for order #{order_number}"
msgstr ""

#: includes/file-handler.php:72
msgid "We need a little more from you"
msgstr ""

#: includes/file-handler.php:74
msgid ""
"<p>Hi {customer_name},</p>\n"
"\t\t\t\t\t\t\t<p>Thank you for uploading your prescription for order "
"#{order_number}. Nothing has been refused. Before a pharmacist at "
"{site_title} can finish the check we need one more thing from you.</p>\n"
"\t\t\t\t\t\t\t<p>{reason}</p>\n"
"\t\t\t\t\t\t\t<p>As soon as we have it we will pick your order straight "
"back up. {reupload_note}</p>\n"
"\t\t\t\t\t\t\t<p>Thank you for your help.</p>\n"
"\t\t\t\t\t\t\t<p>Best regards</p>"
msgstr ""

